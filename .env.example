POSTGRES_USER=dploy_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dploy_db
REDIS_PORT=6379
JWT_SECRET=change_me
API_PORT=8080
REDIS_ADDR=redis:6379
S3_ACCESS_KEY=s3_dploy_admin
S3_SECRET_KEY=s3_dploy_password
ALLOWED_ORIGINS=http://localhost:3000
BASE_DOMAIN_PROTOCOL=http
BASE_DOMAIN=localhost:8080

NEXT_PUBLIC_API_BASE=http://localhost:8080/api
NEXT_PUBLIC_API_BASE=ws://localhost:8080/api
ENV=development
INVITE_CODE=change-me

# How long a new replica gets to answer HTTP before the deploy fails (old version keeps serving)
READY_TIMEOUT=60s
# How long an old replica may keep finishing open requests before it is force-removed
DRAIN_TIMEOUT=60s
